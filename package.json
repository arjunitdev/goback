{
  "name": "retroweb-2012",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Chrome extension that restyles supported sites to a researched 2012-era appearance.",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/build.mjs dev",
    "build:store": "node scripts/build.mjs store",
    "build:test": "node scripts/build.mjs test",
    "package:store": "node scripts/build.mjs store --zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build:test && playwright test",
    "audit:package": "node scripts/audit-package.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:store && npm run audit:package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
